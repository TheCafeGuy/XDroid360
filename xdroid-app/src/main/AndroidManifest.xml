<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Read game dumps anywhere on shared storage (user grants All-files
         access in system settings; requested at Boot time when missing). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Optional cover art download (Settings > About toggle). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Touch controls feedback. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:label="XDroid360"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Fullscreen landscape game session (not exported). -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode" />
        <!-- Touch layout editor from the library, landscape like the game. -->
        <activity
            android:name=".TouchEditorActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
