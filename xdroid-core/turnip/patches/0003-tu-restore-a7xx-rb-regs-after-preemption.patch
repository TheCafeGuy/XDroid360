+                                      &preamble_cs);
       if (result != VK_SUCCESS)
          return vk_startup_errorf(device->instance, result, "switch back amble");
 
+      if (device->rb_regs_shadow)
+         tu7_emit_rb_regs_restore(device, &preamble_cs);
       device->autotune->emit_switch_back_amble(&preamble_cs);
       device->switch_back_amble_entry = tu_cs_end_sub_stream(&device->sub_cs, &preamble_cs);
    }
@@ -2539,10 +2613,13 @@ tu_init_hw(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
                             (1u << TU_PREDICATE_VTX_STATS_NOT_RUNNING));
    }
 
-   if (dev->switch_back_amble_entry.size > 0 && track_preempt_latency) {
+   const struct tu_cs_entry *back =
+      dev->switch_back_amble_entry.size > 0 && track_preempt_latency ?
+      &dev->switch_back_amble_entry : &dev->rb_regs_restore_entry;
+   if (back->size > 0) {
       tu_cs_emit_pkt7(cs, CP_SET_AMBLE, 3);
-      tu_cs_emit_qw(cs, dev->switch_back_amble_entry.bo->iova + dev->switch_back_amble_entry.offset);
-      tu_cs_emit(cs, CP_SET_AMBLE_2_DWORDS(dev->switch_back_amble_entry.size / sizeof(uint32_t)) |
+      tu_cs_emit_qw(cs, back->bo->iova + back->offset);
+      tu_cs_emit(cs, CP_SET_AMBLE_2_DWORDS(back->size / sizeof(uint32_t)) |
                         CP_SET_AMBLE_2_TYPE(PREAMBLE_AMBLE_TYPE));
    } else {
       tu_cs_emit_pkt7(cs, CP_SET_AMBLE, 3);
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index 17bebeb..1988020 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.h
+++ b/src/freedreno/vulkan/tu_cmd_buffer.h
@@ -964,6 +964,64 @@ _tu_create_fdm_bin_patchpoint(struct tu_cmd_buffer *cmd,
 
 VkResult tu_init_bin_preamble(struct tu_device *device);
 
+/* a7xx registers that the switch-back amble restores, and their slots in
+ * tu6_global::preempt_rb_regs. See tu7_emit_rb_regs_restore().
+ */
+enum tu7_rb_shadow_slot {
+   TU7_RB_SHADOW_CLEAR_TARGET,
+   TU7_RB_SHADOW_BUFFER_CNTL,
+   TU7_RB_SHADOW_CCU_CACHE_CNTL,
+   /* Not restored: store_3d_blit keeps the RB_BUFFER_CNTL copy here. */
+   TU7_RB_SHADOW_SAVED_BUFFER_CNTL,
+};
+
+/* Record the value about to be written to a shadowed register. It goes
+ * before the register write, so that a switch between the two writes
+ * restores the new value and the register write then repeats it. BR only:
+ * BV can run ahead of BR into a later render pass.
+ */
+static inline void
+tu7_rb_shadow_write(struct tu_cs *cs, enum tu7_rb_shadow_slot slot,
+                    uint32_t value)
+{
+   if (!cs->device->rb_regs_shadow)
+      return;
+   tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                          CP_COND_REG_EXEC_0_BR);
+   tu_cs_emit_pkt7(cs, CP_MEM_WRITE, 3);
+   tu_cs_emit_qw(cs, cs->device->global_bo->iova +
+                     gb_offset(preempt_rb_regs) + 4 * slot);
+   tu_cs_emit(cs, value);
+   tu_cond_exec_end(cs);
+}
+
+/* Write a shadowed register and its copy. */
+static inline void
+tu7_emit_shadowed_rb_reg(struct tu_cs *cs, enum tu7_rb_shadow_slot slot,
+                         struct tu_reg_value reg)
+{
+   tu7_rb_shadow_write(cs, slot, (uint32_t) reg.value);
+   tu_cs_emit_pkt4(cs, reg.reg, 1);
+   tu_cs_emit(cs, (uint32_t) reg.value);
+}
+
+/* Copy one slot to another, BR only like the writes. */
+static inline void
+tu7_rb_shadow_copy(struct tu_cs *cs, enum tu7_rb_shadow_slot dst,
+                   enum tu7_rb_shadow_slot src)
+{
+   if (!cs->device->rb_regs_shadow)
+      return;
+   uint64_t va = cs->device->global_bo->iova + gb_offset(preempt_rb_regs);
+   tu_cond_exec_start(cs, CP_COND_REG_EXEC_0_MODE(THREAD_MODE) |
+                          CP_COND_REG_EXEC_0_BR);
+   tu_cs_emit_pkt7(cs, CP_MEM_TO_MEM, 5);
+   tu_cs_emit(cs, CP_MEM_TO_MEM_0_WAIT_FOR_MEM_WRITES);
+   tu_cs_emit_qw(cs, va + 4 * dst);
+   tu_cs_emit_qw(cs, va + 4 * src);
+   tu_cond_exec_end(cs);
+}
+
 template <chip CHIP>
 void tu_init_hw_rp(struct tu_cs *cs);
 
