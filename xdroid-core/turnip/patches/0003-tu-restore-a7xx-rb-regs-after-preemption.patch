+/* The a7xx switch-back amble: write back RB_CLEAR_TARGET, RB_BUFFER_CNTL and
+ * RB_CCU_CACHE_CNTL from the copies kept by tu7_emit_shadowed_rb_reg().
+ *
+ * The CP does not restore these registers when it switches back to this
+ * context in the middle of a command buffer. tu_emit_bin_preamble() rewrites
+ * them, but only after a switch at the end of a bin. Under KGSL the CP also
+ * switches to a higher priority context, such as SurfaceFlinger's GLES
+ * composition, inside the bins of a GMEM render pass, and the other context's
+ * values stay in these registers. RB_CLEAR_TARGET left in sysmem mode sends
+ * the GMEM clears in the rest of the pass to memory instead of the tile: the
+ * earlier bins come out black or stale. This amble runs on every switch back
+ * into a command buffer, at any point, in GMEM and sysmem rendering alike.
+ *
+ * The copies are written from the command stream instead of being read from
+ * the registers on the way out: on the Adreno 722, CP_REG_TO_MEM in the
+ * switch-away amble reads all three as 0.
+ */
+static void
+tu7_emit_rb_regs_restore(struct tu_device *dev, struct tu_cs *cs)
+{
+   /* In tu7_rb_shadow_slot order. */
+   const uint32_t regs[] = {
+      RB_CLEAR_TARGET(A7XX).reg,
+      RB_BUFFER_CNTL(A7XX).reg,
+      RB_CCU_CACHE_CNTL(A7XX).reg,
+   };
+   uint64_t va = dev->global_bo->iova + gb_offset(preempt_rb_regs);
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(regs); i++) {
+      tu_cs_emit_pkt7(cs, CP_MEM_TO_REG, 3);
+      tu_cs_emit(cs, CP_MEM_TO_REG_0_REG(regs[i]) | CP_MEM_TO_REG_0_CNT(1));
+      tu_cs_emit_qw(cs, va + 4 * i);
+   }
+}
+
 VkResult
 tu_init_bin_preamble(struct tu_device *device)
 {
    struct tu_cs preamble_cs;
+
+   /* XDroid360 (ARMSX2 267e559): TU_DEBUG=nopreemptrestore turns off the
+    * a7xx RB register shadow and restore, for A/B on one build.
+    */
+   device->rb_regs_shadow = device->physical_device->info->chip == 7 &&
+                            !TU_DEBUG(NO_PREEMPT_RESTORE);
    VkResult result = tu_cs_begin_sub_stream(&device->sub_cs, 256, &preamble_cs);
    if (result != VK_SUCCESS)
       return vk_startup_errorf(device->instance, result, "bin restore");
@@ -2404,12 +2463,27 @@ tu_init_bin_preamble(struct tu_device *device)
       device->switch_away_amble_entry = tu_cs_end_sub_stream(&device->sub_cs, &preamble_cs);
    }
 
+   const uint32_t rb_regs_size = 32;
+   if (device->rb_regs_shadow) {
+      result = tu_cs_begin_sub_stream(&device->sub_cs, rb_regs_size, &preamble_cs);
+      if (result != VK_SUCCESS)
+         return vk_startup_errorf(device->instance, result, "switch back amble");
+
+      tu7_emit_rb_regs_restore(device, &preamble_cs);
+      device->rb_regs_restore_entry = tu_cs_end_sub_stream(&device->sub_cs, &preamble_cs);
+   }
+
    uint32_t switch_back_size = device->autotune->get_switch_back_amble_size();
    if (switch_back_size > 0) {
-      result = tu_cs_begin_sub_stream(&device->sub_cs, switch_back_size, &preamble_cs);
+      result = tu_cs_begin_sub_stream(&device->sub_cs,
+                                      switch_back_size +
