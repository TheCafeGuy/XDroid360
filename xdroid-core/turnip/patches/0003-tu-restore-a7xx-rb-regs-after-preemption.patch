       if (CHIP >= A7XX) {
-         tu_cs_emit_regs(cs, RB_BUFFER_CNTL(CHIP,
+         struct tu_reg_value buffer_cntl = RB_BUFFER_CNTL(CHIP,
             .z_sysmem = true,
             .s_sysmem = true,
             .rt0_sysmem = true,
@@ -1906,7 +1906,11 @@ r3d_setup(struct tu_cmd_buffer *cmd,
             .rt5_sysmem = true,
             .rt6_sysmem = true,
             .rt7_sysmem = true,
-         ));
+         );
+         if (CHIP == A7XX)
+            tu7_rb_shadow_write(cs, TU7_RB_SHADOW_BUFFER_CNTL, (uint32_t) buffer_cntl.value);
+         tu_cs_emit_pkt4(cs, buffer_cntl.reg, 1);
+         tu_cs_emit(cs, (uint32_t) buffer_cntl.value);
       }
    }
 
@@ -4183,8 +4187,8 @@ clear_image_event_blit(struct tu_cmd_buffer *cmd,
 
    struct tu_cs *cs = &cmd->cs;
 
-   tu_cs_emit_regs(cs,
-                   RB_CLEAR_TARGET(A7XX, .clear_mode = CLEAR_MODE_SYSMEM));
+   tu7_emit_shadowed_rb_reg(cs, TU7_RB_SHADOW_CLEAR_TARGET,
+                            RB_CLEAR_TARGET(A7XX, .clear_mode = CLEAR_MODE_SYSMEM));
 
    tu_cs_emit_pkt4(cs, REG_A6XX_RB_RESOLVE_CNTL_0, 1);
    tu_cs_emit(cs, 0);
@@ -5916,6 +5920,12 @@ store_3d_blit(struct tu_cmd_buffer *cmd,
       tu_cs_emit(cs, CP_REG_TO_SCRATCH_0_REG(RB_BUFFER_CNTL(CHIP).reg) |
                      CP_REG_TO_SCRATCH_0_SCRATCH(1) |
                      CP_REG_TO_SCRATCH_0_CNT(1 - 1));
+      /* Its preemption copy too: r3d_setup overwrites it, and the value is
+       * not known when recording.
+       */
+      if (CHIP == A7XX)
+         tu7_rb_shadow_copy(cs, TU7_RB_SHADOW_SAVED_BUFFER_CNTL,
+                            TU7_RB_SHADOW_BUFFER_CNTL);
    }
 
    r3d_setup<CHIP>(cmd, cs, src_format, dst_format, VK_IMAGE_ASPECT_COLOR_BIT,
@@ -5964,6 +5974,9 @@ store_3d_blit(struct tu_cmd_buffer *cmd,
                   CP_SCRATCH_TO_REG_0_CNT(1 - 1));
 
    if (CHIP >= A7XX) {
+      if (CHIP == A7XX)
+         tu7_rb_shadow_copy(cs, TU7_RB_SHADOW_BUFFER_CNTL,
+                            TU7_RB_SHADOW_SAVED_BUFFER_CNTL);
       tu_cs_emit_pkt7(cs, CP_SCRATCH_TO_REG, 1);
       tu_cs_emit(cs, CP_SCRATCH_TO_REG_0_REG(RB_BUFFER_CNTL(CHIP).reg) |
                         CP_SCRATCH_TO_REG_0_SCRATCH(1) |
